# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=agrofresh

# Optional MySQL Source (only if you still have old DB access)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=agrofresh

# If MySQL is not reachable, set true to run bootstrap mode
ALLOW_NO_MYSQL=true

# Optional bootstrap admin seed for no-MySQL mode
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_EMAIL=admin@agrofresh.com
SEED_ADMIN_PASSWORD=ChangeThisNow123!
SEED_ADMIN_PHONE=0241234567

# Session Configuration
SESSION_SECRET=your-secret-key-change-this

# Sendstack Configuration
SENDSTACK_APP_ID=your_sendstack_app_id
SENDSTACK_APP_SECRET=your_sendstack_app_secret
SENDSTACK_API_KEY=your_sendstack_api_key

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=30000

# Optional external market-demand provider
MARKET_DEMAND_API_URL=https://your-market-provider.example/api/demand
MARKET_DEMAND_API_KEY=your_market_demand_api_key
MARKET_DEMAND_PROVIDER=External market provider
MARKET_DEMAND_COUNTRY=Ghana
MARKET_DEMAND_API_TIMEOUT=8000

# EmailJS notification delivery
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Arkesel SMS notification delivery
ARKESEL_API_KEY=your_arkesel_api_key
ARKESEL_SENDER=AgroFresh

# Didit identity verification (server-side only)
DIDIT_API_KEY=your_didit_api_key
DIDIT_WORKFLOW_ID=your_didit_workflow_id
DIDIT_WEBHOOK_SECRET=your_didit_webhook_secret
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_CALLBACK_URL=https://your-app.vercel.app/verify-farmer